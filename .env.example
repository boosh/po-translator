# The provider is chosen by whichever API key is set below. With only one key
# set there is nothing to configure; with keys for several providers, name the
# one to use in LLM_PROVIDER (or pass --provider) rather than leaving the tool
# to guess.

OPENROUTER_API_KEY=""
# DIGITALOCEAN_MODEL_ACCESS_KEY=""
# GOOGLE_API_KEY=""
# GEMINI_API_KEY is accepted as an alternative to GOOGLE_API_KEY.

# Which provider to use: openrouter, digitalocean or google. Only needed when
# more than one of the keys above is set. Override it per run with --provider.
# LLM_PROVIDER="openrouter"

# The model to translate with. Required — there is no built-in default, since
# models are released and retired too often to pin one in the binary. Use the
# name the chosen provider expects, and override it per run with --model.
LLM_MODEL="anthropic/claude-sonnet-4.5"

# OpenRouter presets (configured at https://openrouter.ai/settings/presets) go
# in the same setting. Either use the preset on its own:
# LLM_MODEL="@preset/po-translation"
# or pin a model and apply the preset's parameters to it:
# LLM_MODEL="anthropic/claude-sonnet-4.5@preset/po-translation"

# Optional. Overrides the endpoint of the chosen provider, which defaults to
# https://openrouter.ai/api/v1 for OpenRouter and https://inference.do-ai.run/v1
# for DigitalOcean. Ignored by Google. Override it per run with --base-url.
# LLM_BASE_URL=""
