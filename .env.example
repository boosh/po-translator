# API Keys for the AI providers.
# You only need to provide a key for the provider you intend to use.
# The application will also check for GEMINI_API_KEY as an alternative for Google.

DIGITALOCEAN_MODEL_ACCESS_KEY=""
GOOGLE_API_KEY=""
ANTHROPIC_API_KEY=""

# Optional. Overrides the DigitalOcean inference endpoint, which defaults to:
# DIGITALOCEAN_INFERENCE_BASE_URL="https://inference.do-ai.run/v1"
